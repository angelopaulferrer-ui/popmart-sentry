{
  "name": "popmart-sentry",
  "version": "0.1.0",
  "description": "Restock monitor for Pop Mart products — polls product pages and alerts when items come back in stock.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "popmart-sentry": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check": "tsx src/index.ts --once"
  },
  "keywords": [
    "popmart",
    "restock",
    "monitor",
    "labubu",
    "scraper"
  ],
  "license": "MIT",
  "dependencies": {
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
