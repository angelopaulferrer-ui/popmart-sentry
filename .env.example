# Poll interval in seconds (default 300 = 5 min). Keep it polite to avoid rate limiting.
POLL_INTERVAL_SECONDS=300

# Optional Discord webhook for restock alerts.
DISCORD_WEBHOOK_URL=

# Optional Slack webhook for restock alerts.
SLACK_WEBHOOK_URL=

# Optional Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# User-Agent sent with requests.
USER_AGENT=popmart-sentry/0.1 (+https://github.com/)
